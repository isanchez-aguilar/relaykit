  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "ci-local": "node bin/relaykit.mjs ci-local",
    "doctor": "node bin/relaykit.mjs doctor",
    "prepublishOnly": "node --test"
  }
}
