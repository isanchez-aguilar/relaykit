    "jules",
    "qwen",
    "llm",
    "cli",
    "developer-tools",
    "code-review",
    "orchestration",
    "handoff",
    "agents-md",
    "coding-agents"
  ],
  "homepage": "https://github.com/isanchez-aguilar/relayrace-ai#readme",
  "bugs": {
    "url": "https://github.com/isanchez-aguilar/relayrace-ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isanchez-aguilar/relayrace-ai.git"
  },
  "license": "(Apache-2.0 AND MIT)",
  "author": {
    "name": "Isaac Sanchez Aguilar",
    "url": "https://github.com/isanchez-aguilar"
  },
  "type": "module",
  "bin": {
    "relayrace-ai": "bin/relayrace.mjs",
    "relayrace": "bin/relayrace.mjs"
  },
  "files": [
    "bin",
    "lib",
    "!lib/**/*.test.mjs",
    "agents",
    "skills",
    "templates",
    "prompts",
    "docs",
