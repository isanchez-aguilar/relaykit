  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "ci-local": "node bin/relayrace.mjs ci-local",
    "doctor": "node bin/relayrace.mjs doctor",
    "prepublishOnly": "node --test"
  }
